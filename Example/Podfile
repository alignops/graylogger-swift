source 'https://github.com/alignops/busypods-ios.git'
source 'https://github.com/CocoaPods/Specs.git'

use_frameworks!

target 'graylogger_Example' do
	platform :ios, '10.0'
	pod 'graylogger', :path => '../'
	pod 'graylogger/CoreDataCache', :path => '../'
	pod 'graylogger/ReachabilitySwift', :path => '../'
    pod 'AFNetworking/NSURLSession', :git => 'git@github.com:alignops/AFNetworking.git'
	pod 'graylogger/AFNetworking', :path => '../'
	pod 'graylogger/Alamofire', :path => '../'
	pod 'graylogger/AnalyticsKit', :path => '../'
	
	pod 'AnalyticsKit/Core', :git => 'git@github.com:twobitlabs/AnalyticsKit.git'

  target 'graylogger_Tests' do
    inherit! :search_paths
	pod 'graylogger/CoreDataCache', :path => '../'
	pod 'SwiftyJSON'
  end
  
end

post_install do |installer|
	installer.pods_project.targets.each do |target| 
		target.build_configurations.each do |config|
			config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '10.0'
		end
	end
	installer.pods_project.build_configurations.each do |config|
		config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
	end
end
